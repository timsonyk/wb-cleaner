# ── Postgres (читается docker-compose и drizzle) ──
POSTGRES_DB=wb_cleaner
POSTGRES_USER=wb_cleaner
POSTGRES_PASSWORD=wb_cleaner
POSTGRES_PORT=5432

# Полный URL для приложения. Если меняешь creds выше — обнови и здесь.
DATABASE_URL=postgres://wb_cleaner:wb_cleaner@localhost:5432/wb_cleaner

# ── Шифрование WB JWT-токенов ──
# 32 байта случайных данных в base64. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# КРИТИЧНО: при ротации ключа существующие зашифрованные токены перестанут
# расшифровываться — нужна процедура re-encrypt. Не теряй его.
TOKEN_ENCRYPTION_KEY=

# ── Auth.js (next-auth v5) ──
# Подписи session-cookie и CSRF. Без него Auth.js падает на старте.
# Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Публичный URL приложения. Для локалки — http://localhost:3000.
# Если ставишь на прод — поменяй на свой домен (https://...).
AUTH_URL=http://localhost:3000

# ── Resend (отправка magic link) ──
# API-ключ: https://resend.com/api-keys
AUTH_RESEND_KEY=

# От кого приходит письмо. ВАЖНО: в режиме разработки Resend разрешает слать
# письма только на адрес владельца аккаунта (если домен ещё не верифицирован).
# Поэтому EMAIL_FROM на старте делай через onboarding@resend.dev — это
# рабочий sender от Resend для тестов; тестовый получатель — твой собственный
# email, на котором зарегистрирован Resend.
# В проде: подключи свой домен в Resend → укажи "WB Cleaner <noreply@yourdomain>".
EMAIL_FROM=WB Cleaner <onboarding@resend.dev>
